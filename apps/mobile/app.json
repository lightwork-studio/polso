{
  "expo": {
    "name": "Polso Preview",
    "slug": "polso-preview",
    "scheme": "polso-preview",
    "version": "0.1.0",
    "platforms": ["ios"],
    "runtimeVersion": {
      "policy": "fingerprint"
    },
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "app.polso.preview",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSLocalNetworkUsageDescription": "While you turn on agent access, Polso answers AI agents on your local network."
      }
    },
    "plugins": [
      "expo-router",
      [
        "@kingstinct/react-native-healthkit",
        {
          "NSHealthShareUsageDescription": "Polso reads the Health data you choose so your AI agents can answer questions about it.",
          "NSHealthUpdateUsageDescription": false,
          "background": false
        }
      ]
    ],
    "experiments": {
      "typedRoutes": false
    },
    "updates": {
      "enabled": false
    }
  }
}
