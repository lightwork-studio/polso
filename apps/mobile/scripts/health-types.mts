// Writes src/health/types.generated.ts from the HealthKit schema that ships with
// @kingstinct/react-native-healthkit, so Polso asks for every quantity and category type the
// library can read. Run it after upgrading the library: `node scripts/health-types.mts`.
// A test fails when the checked-in file no longer matches the installed schema.
import { readFileSync, writeFileSync } from "node:fs";
import { fileURLToPath } from "node:url";

interface SchemaQuantity {
  name: string;
  ios: string;
  canonicalUnit: string | null;
  aggregationStyle: string;
  legacy: boolean;
}
interface SchemaCategory {
  name: string;
  ios: string;
  valueEnum: string;
  legacy: boolean;
}
interface SchemaEnum {
  name: string;
  members: { name: string; rawValue: number }[];
}
export interface HealthKitSchema {
  quantityIdentifiers: SchemaQuantity[];
  categoryIdentifiers: SchemaCategory[];
  enums: SchemaEnum[];
}

export const schemaPath = fileURLToPath(
  new URL(
    "../node_modules/@kingstinct/react-native-healthkit/src/generated/healthkit-schema.json",
    import.meta.url,
  ),
);
export const outputPath = fileURLToPath(
  new URL("../src/health/types.generated.ts", import.meta.url),
);

export function readSchema(): HealthKitSchema {
  return JSON.parse(readFileSync(schemaPath, "utf8"));
}

/** Renders the generated module. Legacy identifiers, which Apple has replaced, are left out. */
export function renderHealthTypes(schema: HealthKitSchema): string {
  const enums = new Map(schema.enums.map((e) => [`HK${e.name}`, e]));
  const quantities = schema.quantityIdentifiers
    .filter((q) => !q.legacy)
    .map((q) => ({
      id: q.name,
      ios: q.ios,
      ...(q.canonicalUnit ? { unit: q.canonicalUnit } : {}),
    }));
  const categories = schema.categoryIdentifiers
    .filter((c) => !c.legacy)
    .map((c) => {
      const values: Record<string, string> = {};
      for (const m of enums.get(c.valueEnum)?.members ?? []) values[m.rawValue] = m.name;
      return { id: c.name, ios: c.ios, values };
    });
  const json = (value: unknown) => JSON.stringify(value, null, 2);
  return `// Generated by scripts/health-types.mts from the HealthKit schema in
// @kingstinct/react-native-healthkit. Do not edit by hand.

export interface GeneratedQuantityType {
  readonly id: string;
  /** The first iOS version with this type. */
  readonly ios: string;
  /** HealthKit's canonical unit. Without one, HealthKit picks the preferred unit. */
  readonly unit?: string;
}

export interface GeneratedCategoryType {
  readonly id: string;
  readonly ios: string;
  /** Names of the type's category values, by raw value. */
  readonly values: Readonly<Record<string, string>>;
}

export const QUANTITY_TYPES: readonly GeneratedQuantityType[] = ${json(quantities)};

export const CATEGORY_TYPES: readonly GeneratedCategoryType[] = ${json(categories)};
`;
}

if (process.argv[1] && fileURLToPath(import.meta.url) === process.argv[1]) {
  writeFileSync(outputPath, renderHealthTypes(readSchema()));
  console.log(`Wrote ${outputPath}`);
}
