{
  "name": "polso",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.21.0",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "check": "pnpm lint && pnpm typecheck && pnpm test",
    "check:builds": "pnpm --filter @polso/mobile check:ios-bundle",
    "lint": "biome check .",
    "format": "biome check --write .",
    "typecheck": "pnpm -r --if-present typecheck",
    "test": "vitest run",
    "dev:app": "pnpm --filter @polso/mobile start"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.9",
    "@types/node": "^22.0.0",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  }
}
