diff --git a/ios/TcpSockets.m b/ios/TcpSockets.m
index a5553c66c659a8f582e1e7b1aded0fad87e399c5..d344630c3c724cafa98be4d92d3b9d271344dee8 100644
--- a/ios/TcpSockets.m
+++ b/ios/TcpSockets.m
@@ -19,6 +19,18 @@
 
 RCT_EXPORT_MODULE()
 
+// The sockets call back on the main queue (TcpSocketClient's methodQueue) and
+// change _clients there. Without this, the exported methods would run on
+// React Native's own queue and read _clients at the same time, unlocked,
+// which a flood of connections can turn into a crash. One queue for both.
+- (dispatch_queue_t)methodQueue {
+    return dispatch_get_main_queue();
+}
+
++ (BOOL)requiresMainQueueSetup {
+    return NO;
+}
+
 - (NSArray<NSString *> *)supportedEvents {
     return @[
         @"connect", @"listening", @"connection", @"secureConnection", @"data",
@@ -286,6 +298,16 @@ RCT_EXPORT_METHOD(getCertificate:(nonnull NSNumber *)cId
                   toClient:(NSNumber *)clientID
             connectionType:(NSString *)connectionType {
     GCDAsyncSocket *socket = [client getSocket];
+    // As in onConnect: if the peer went away before this ran, the address
+    // getters return nil and the dictionary below would throw and crash the
+    // app. Each getter asks the system again, so read each once, then drop
+    // the connection if either is missing; JS never learned about it.
+    NSString *localAddress = [socket localHost];
+    NSString *remoteAddress = [socket connectedHost];
+    if (localAddress == nil || remoteAddress == nil) {
+        [socket disconnect];
+        return;
+    }
 
     [self sendEventWithName:connectionType
                        body:@{
@@ -293,10 +315,10 @@ RCT_EXPORT_METHOD(getCertificate:(nonnull NSNumber *)cId
                            @"info" : @{
                                @"id" : client.id,
                                @"connection" : @{
-                                   @"localAddress" : [socket localHost],
+                                   @"localAddress" : localAddress,
                                    @"localPort" : [NSNumber
                                        numberWithInt:[socket localPort]],
-                                   @"remoteAddress" : [socket connectedHost],
+                                   @"remoteAddress" : remoteAddress,
                                    @"remotePort" : [NSNumber
                                        numberWithInt:[socket connectedPort]],
                                    @"remoteFamily" : [socket isIPv4] ? @"IPv4"
